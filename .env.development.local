# === Rayo TEST BRANCH overrides ===
# This file lives ONLY on the `test` branch. Next.js auto-loads it during
# `npm run dev`, switching the app to Hyperliquid testnet and skipping Privy.
#
# DO NOT merge this file into main. The .gitignore on main does not include
# it; this file exists here because of the !.env.development.local exception.

NEXT_PUBLIC_USE_TESTNET=1
NEXT_PUBLIC_BYPASS_AUTH=1

# Address used as the connected wallet when BYPASS_AUTH is on. Replace with a
# real testnet address that holds funds if you want to see balances.
NEXT_PUBLIC_TEST_WALLET=0x0000000000000000000000000000000000000001
