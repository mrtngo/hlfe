# Privy App ID
# Get your Privy App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Note: This file is a template. Copy it to .env.local and fill in your actual values.
# The .env.local file is gitignored and will not be committed to GitHub.

# === Test-mode flags (DEFAULT OFF on main / production) ===
# The `test` branch enables both of these via a committed .env.development.local
# file (un-ignored in .gitignore). Next.js auto-loads that file during `npm run
# dev`. Leave them unset on main to keep mainnet + Privy auth.
# NEXT_PUBLIC_USE_TESTNET=1
# NEXT_PUBLIC_BYPASS_AUTH=1
# NEXT_PUBLIC_TEST_WALLET=0xYOUR_TESTNET_ADDRESS_LOWERCASE
