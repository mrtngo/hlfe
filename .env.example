# Privy App ID
# Get your Privy App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Note: This file is a template. Copy it to .env.local and fill in your actual values.
# The .env.local file is gitignored and will not be committed to GitHub.

# === Testnet toggle (DEFAULT OFF on main / production) ===
# `npm run dev:test` flips this on for a single dev session. Privy auth
# stays active — you log in normally and the app just talks to Hyperliquid
# testnet instead of mainnet.
# NEXT_PUBLIC_USE_TESTNET=1
