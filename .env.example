# Privy App ID
# Get your Privy App ID from https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_server_side_privy_app_secret_here
# Optional: paste the dashboard verification key to avoid fetching JWKS.
# PRIVY_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_side_service_role_key_here

# API hardening
PUSH_API_SECRET=generate_a_long_random_secret
CRON_SECRET=generate_a_long_random_secret
API_ALLOWED_ORIGINS=https://www.rayotrade.xyz,https://rayotrade.xyz,capacitor://localhost

# Note: This file is a template. Copy it to .env.local and fill in your actual values.
# The .env.local file is gitignored and will not be committed to GitHub.

# === Testnet toggle (DEFAULT OFF on main / production) ===
# `npm run dev:test` flips this on for a single dev session. Privy auth
# stays active — you log in normally and the app just talks to Hyperliquid
# testnet instead of mainnet.
# NEXT_PUBLIC_USE_TESTNET=1
