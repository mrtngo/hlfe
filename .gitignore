# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Exceptions:
#  - .env.example is checked in as a template for new contributors.
#  - .env.development.local is committed ONLY on the `test` branch (gives it
#    testnet + bypass auth automatically via `npm run dev`). Safe on main
#    because the file does not exist there.
!.env.example
!.env.development.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor
_api_temp/
ios/App/App/public/
ios/App/Pods/

# Local/AI files
.claude/
task.md
design_handoff_inicio_redesign/
handoff_2/
