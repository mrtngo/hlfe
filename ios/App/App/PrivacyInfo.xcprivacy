<?xml version="1.0" encoding="UTF-8"?>
<!--
  Apple Privacy Manifest for Rayo iOS app.

  Required since May 2024 for apps using "Required Reason" APIs.
  Declares: required-reason API usage, tracked-domain list, and data
  collection types. Keep this in sync with whatever third-party SDKs
  ship inside the binary — Capacitor, WalletConnect, Privy, etc.

  https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Whether the app or any embedded SDK performs tracking under
	     Apple's definition (linking user/device identity across apps for
	     advertising). Rayo does not. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- Domains used for tracking. Empty because NSPrivacyTracking=false. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Categories of data collected. Wallet addresses are not Apple-defined
	     PII; analytics + crash logs are functional. If you add a Sentry/
	     PostHog/Amplitude SDK later, update this list. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- Email addresses captured via Privy email login. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAuthentication</string>
			</array>
		</dict>
		<dict>
			<!-- Crash reports / diagnostics. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCrashData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Product-interaction analytics (which screens viewed, which
			     CTAs tapped). Not linked to the user identity. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- Required Reason API usage. Capacitor's runtime reads UserDefaults
	     (Preferences plugin), file timestamps (logging), and system boot
	     time (debug). Reason codes per Apple's allowed list. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1 — Access info from same app's own group container. -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1 — Inspect file timestamps the app itself wrote. -->
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1 — Calculate timestamps to display in the user-facing
				     UI (e.g. log timestamps, debug overlay). -->
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1 — Display available disk space to the user, or
				     refuse to write when low. WebKit uses this. -->
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
